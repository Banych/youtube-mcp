# Bearer token Claude sends in the Authorization header. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MCP_TOKEN=

# Channels to watch: channel IDs (UC…), @handles or youtube.com channel URLs,
# separated by commas or newlines. IDs are fastest; handles are resolved on
# first use and cached per server instance.
YT_CHANNELS=@ThePrimeTimeagen,@Fireship
